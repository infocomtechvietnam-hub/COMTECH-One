# ============================================================
# COMTECH One: biến môi trường mẫu (DEV). Sao chép thành .env
# Staging/production: secret nạp từ Secret Manager, KHÔNG dùng file .env (SPEC 16.4)
# ============================================================

# ---- Chung ----
APP_ENV=dev                      # dev | staging | production
NODE_ENV=development

# ---- API (apps/api) ----
PORT=4000
DATABASE_URL=postgresql://comtech:comtech_dev_only@localhost:5432/comtech_one
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
LEAD_RATE_LIMIT_PER_MIN=30
# Bắt buộc ở production (Cloudflare Turnstile). Để trống ở DEV = tắt captcha.
TURNSTILE_SECRET=

# ---- Worker (email lead) ----
SMTP_HOST=localhost              # mailpit ở DEV
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="COMTECH <no-reply@comtechvietnam.vn>"
LEAD_NOTIFY_TO=sales@example.invalid   # [COMTECH INPUT REQUIRED] hộp thư nhận lead
OUTBOX_POLL_MS=5000

# ---- Website (apps/web) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# true = bản xem trước nội bộ (hiện nội dung chờ duyệt + DEMO có nhãn). CẤM ở APP_ENV=production.
CONTENT_PREVIEW=false
